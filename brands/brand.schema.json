{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZachPulse/iblusend-plugins/blob/main/brands/brand.schema.json",
  "title": "iBluSend plugin brand package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "publisher",
    "legal",
    "mcp",
    "branding",
    "copy",
    "marketplaces"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "displayName",
        "version",
        "description",
        "longDescription",
        "category",
        "capabilities",
        "keywords"
      ],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 20, "maxLength": 180 },
        "longDescription": { "type": "string", "minLength": 40, "maxLength": 500 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "developerName", "email", "url", "repository"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "developerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "format": "email" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "repository": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homepage", "website", "support", "privacy", "terms", "license"],
      "properties": {
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "website": { "$ref": "#/$defs/httpsUrl" },
        "support": { "$ref": "#/$defs/httpsUrl" },
        "privacy": { "$ref": "#/$defs/httpsUrl" },
        "terms": { "$ref": "#/$defs/httpsUrl" },
        "license": { "const": "MIT" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverName", "resourceUrl"],
      "properties": {
        "serverName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "resourceUrl": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryColor",
        "accentColor",
        "monogram",
        "composerIcon",
        "lightLogo",
        "darkLogo",
        "screenshots"
      ],
      "properties": {
        "primaryColor": { "$ref": "#/$defs/hexColor" },
        "accentColor": { "$ref": "#/$defs/hexColor" },
        "monogram": { "type": "string", "pattern": "^[A-Za-z0-9]{1,3}$" },
        "composerIcon": { "$ref": "#/$defs/generatedAsset" },
        "lightLogo": { "$ref": "#/$defs/generatedAsset" },
        "darkLogo": { "$ref": "#/$defs/generatedAsset" },
        "screenshots": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/generatedAsset" }
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channelName", "workspaceName", "starterPrompts"],
      "properties": {
        "channelName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "workspaceName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "starterPrompts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "marketplaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "displayName", "installation", "authentication"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
            "installation": { "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"] },
            "authentication": { "enum": ["ON_INSTALL", "ON_USE"] }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "description": { "type": "string", "minLength": 20, "maxLength": 180 }
          }
        }
      }
    },
    "infrastructureAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedBrandReferences"],
      "properties": {
        "allowedBrandReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "generatedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "const": "generated" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
